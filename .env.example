# ── WhatsApp Settings ──────────────────────────────────────────────
# Default country code (without +). Used when phone number has no country code.
# 34 = Spain | 57 = Colombia | 52 = Mexico | 55 = Brazil | 1 = USA
COUNTRY_CODE=34

# Delay between WhatsApp messages in milliseconds (min recommended: 12000)
# Too fast = risk of getting banned. 15-30s is safe.
MESSAGE_DELAY_MS=18000

# ── Scraper Settings ───────────────────────────────────────────────
# Delay between clicking each business on Google Maps (ms)
SCRAPE_DELAY_MS=2500

# Max leads to collect per search
MAX_LEADS=50

# Show browser while scraping? true = visible, false = headless
SCRAPER_HEADLESS=false

# ── Message Template ───────────────────────────────────────────────
# Available placeholders: {name}, {category}, {address}
MESSAGE_TEMPLATE=Hola {name}! 👋

Vi tu negocio en Google Maps y quería escribirte.

Somos una agencia de diseño web y ayudamos a negocios locales como el tuyo a conseguir más clientes con una página web profesional.

Si te interesa, podemos hacer una consulta gratuita sin compromiso. 🙌

¿Cuándo tienes un momento para hablar?
