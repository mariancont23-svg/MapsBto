# ── Discord Bot ────────────────────────────────────────────────────
# Create a bot at https://discord.com/developers/applications
# → New Application → Bot → Reset Token → Copy
DISCORD_BOT_TOKEN=your_bot_token_here

# ── Google Places API ──────────────────────────────────────────────
# Enable "Places API" at https://console.cloud.google.com
GOOGLE_PLACES_API_KEY=your_places_api_key_here

# ── Settings ───────────────────────────────────────────────────────
# Country code without + (40=Romania, 44=UK, 49=Germany, 1=USA)
COUNTRY_CODE=40

# Max leads per scrape if not specified in command (e.g. !scrape restaurants Bucharest)
DEFAULT_MAX_LEADS=20

# ── WhatsApp Business Cloud API ────────────────────────────────────
# Get these from https://developers.facebook.com → your app → WhatsApp → API Setup
# WHATSAPP_TOKEN  = your permanent/temporary access token
# WHATSAPP_PHONE_ID = Phone Number ID (NOT the phone number itself)
WHATSAPP_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_ID=your_phone_number_id_here

# ── WhatsApp Message ───────────────────────────────────────────────
# {name} = business name  {category} = type  {address} = address
MESSAGE_TEMPLATE=Hello {name}!

I found your business on Google Maps and wanted to reach out.

We are a web design agency and we help local businesses attract more customers with a professional website.

If you're interested, we offer a free consultation with no obligation.

When would be a good time to chat?
